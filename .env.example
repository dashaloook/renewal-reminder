# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored, so your key never reaches GitHub.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys). Server-only — never put it in app.js.
RESEND_API_KEY=

# Where test reminders are sent. On Resend's free plan this must be the email you signed up with.
REMINDER_TO_EMAIL=

# Optional: sender. Leave empty to use Resend's test sender (onboarding@resend.dev).
RESEND_FROM=

# Optional: only accept requests from your deployed site, e.g. https://renewal-reminder.vercel.app
ALLOWED_ORIGIN=
