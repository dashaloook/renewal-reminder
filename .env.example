# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored, so your key never reaches GitHub.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys). Server-only — never put it in app.js.
RESEND_API_KEY=

# Emails go to the signed-in user's own Google address (checked on the server).
# Optional: sender. Needs a domain verified in Resend to email anyone but you. Leave empty to use Resend's test sender (onboarding@resend.dev).
RESEND_FROM=

# Optional: only accept requests from your deployed site, e.g. https://renewal-reminder-one.vercel.app
ALLOWED_ORIGIN=

# ---- Automatic daily reminder emails (api/daily_reminders.py, run by Vercel Cron) ----
# The whole Firebase service-account key file (JSON, one line is fine).
# Firebase → Project settings → Service accounts → Generate new private key. Server-only.
FIREBASE_SERVICE_ACCOUNT=

# Any long random string. Vercel Cron sends it, so nobody else can run the job.
CRON_SECRET=
